# Copia este archivo como .env y rellena lo que necesites.
# El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).

# --- Datos ---
RUTA_BD=datos/salud.db
ZONA_HORARIA=Europe/Madrid

# --- Cuándo avisar ---
# Días de antelación del primer aviso, y a qué hora llega
DIAS_ANTES=2
HORA_AVISO_PREVIO=10:00
# Hora del aviso del mismo día (si la cita es antes, avisa 1 hora antes de la cita)
HORA_AVISO_DIA=07:30
# Cada cuántos minutos revisa las citas la orden vigilar
MINUTOS_ENTRE_REVISIONES=5

# --- Por dónde llegan los avisos ---
# consola = se ven en la pantalla (para probar) / telegram = te llegan al móvil
CANAL=consola
# El token se consigue en la GUIA.md, paso 0.8 (gratis, con @BotFather en Telegram).
# El número de chat, en el ticket ACS-002.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Inteligencia artificial (opcional, gratis) ---
# ninguno | gemini | groq | openrouter | ollama
IA_PROVEEDOR=ninguno
# Gemini: clave gratis en https://aistudio.google.com/apikey
IA_API_KEY=
# Comprueba en la web del proveedor qué modelo es gratis ahora mismo.
# Ejemplo para Gemini: gemini-3.6-flash
IA_MODELO=
# Solo si quieres usar otra dirección distinta a la del proveedor
IA_URL_BASE=
